# =============================================================================
# Surya Teja Portfolio — Environment Configuration Template
# =============================================================================
# DO NOT commit your real keys or passwords to GitHub.
# Copy this file to .env and fill in your Supabase credentials:
# cp .env.example .env

# Your Supabase Project URL (from https://supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anonymous Key (safe for browser client-side auth)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# The only email authorized to access the Admin CMS area
VITE_ADMIN_EMAIL=suryasanku800@gmail.com

# Web3Forms Public Access Key for instant email delivery of contact inquiries
# (Get free instant key in 10 seconds at https://web3forms.com by entering suryasanku800@gmail.com)
VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

